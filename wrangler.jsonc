{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kuznechny-dvorik-gates",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-09-08",
  "workers_dev": true,
  "keep_vars": true,
  "assets": {
    "directory": "./dist/client"
  },
  "d1_databases": [
    {
      "binding": "DB"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET"
    }
  ]
}
