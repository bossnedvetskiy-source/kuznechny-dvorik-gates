Options -Indexes
DirectoryIndex index.html index.htm

RewriteEngine On

# Never expose the repository metadata used for pull-based deployments.
RewriteRule (^|/)\.git(?:/|$) - [F,L]

# Transitional backend: keep the current Cloudflare/D1 API working while the
# public files are served by Timeweb.
RewriteRule ^api/(.*)$ api-proxy.php?__proxy_path=api/$1 [QSA,L]
RewriteRule ^catalog-media/(.*)$ api-proxy.php?__proxy_path=catalog-media/$1 [QSA,L]

# Friendly routes used by the current Worker site.
RewriteRule ^admin/?$ admin.html [L]
RewriteRule ^vorota/?$ index.html [L]
RewriteRule ^napravleniya/?$ napravleniya/index.html [L]

<IfModule mod_headers.c>
  # The tw1.ru address is a migration/test copy and must not compete with the
  # production domain in search engines.
  Header set X-Robots-Tag "noindex, nofollow, noarchive"
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Deployment helpers and private health markers must never be public.
# api-proxy.php is intentionally NOT denied here: /api/* rewrites execute it.
# A direct request to api-proxy.php safely returns 404 because __proxy_path is absent.
<FilesMatch "^(?:deploy-timeweb\.sh|health-check\.sh|timeweb-build\.txt|\.timeweb-health)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
