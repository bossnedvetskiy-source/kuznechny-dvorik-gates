Options -Indexes
DirectoryIndex index.html index.htm

RewriteEngine On

# Never expose repository metadata or PHP backend internals.
RewriteRule (^|/)\.git(?:/|$) - [F,L]
RewriteRule ^backend(?:/|$) - [F,L]

# Shadow PHP/MySQL backend. It is tested independently before the public API is
# switched away from Cloudflare.
RewriteRule ^api-local/(.*)$ local-api.php?__route=$1 [QSA,L]
RewriteRule ^catalog-media-local/(.*)$ local-api.php?__route=catalog-media/$1 [QSA,L]

# Transitional production backend: keep Cloudflare/D1 live until the MySQL
# import and shadow checks are complete.
RewriteRule ^api/(.*)$ api-proxy.php?__proxy_path=api/$1 [QSA,L]
RewriteRule ^catalog-media/(.*)$ api-proxy.php?__proxy_path=catalog-media/$1 [QSA,L]

# Friendly routes used by the current site.
RewriteRule ^admin/?$ admin.html [L]
RewriteRule ^vorota/?$ index.html [L]
RewriteRule ^napravleniya/?$ napravleniya/index.html [L]

<IfModule mod_headers.c>
  # The tw1.ru address is a migration/test copy and must not compete with the
  # production domain in search engines.
  Header set X-Robots-Tag "noindex, nofollow, noarchive"
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Deployment/setup helpers and private health markers must never be public.
<FilesMatch "^(?:deploy-timeweb\.sh|install-autodeploy\.sh|health-check\.sh|setup-timeweb\.php|migrate-from-cloudflare\.php|timeweb-build\.txt|\.timeweb-health)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
